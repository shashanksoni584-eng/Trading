rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','mobile','email','order_id','amount','status','createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() < 80
                    && request.resource.data.mobile.matches('^[6-9][0-9]{9}$');
      allow read, update, delete: if false;   // view leads in Firebase console
    }
  }
}
